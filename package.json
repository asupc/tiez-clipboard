{
  "name": "tiez-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:coverage:rust": "rustup run stable cargo llvm-cov --manifest-path src-tauri/Cargo.toml --html",
    "test:preflight": "node scripts/run-preflight-tests.mjs",
    "test:e2e": "npm --prefix e2e test",
    "preflight": "node scripts/run-preflight-tests.mjs",
    "lint": "eslint src",
    "lint:styles": "node scripts/lint-styles.mjs",
    "apply-version": "node scripts/apply-app-version.mjs",
    "apply-version:win": "node scripts/apply-app-version.mjs windows",
    "validate-release": "node scripts/validate-release.mjs",
    "validate-release-matrix": "node scripts/validate-release-matrix.mjs",
    "release:stable:win": "node scripts/build-release.mjs windows stable",
    "release:beta:win": "node scripts/build-release.mjs windows beta",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:dev": "node scripts/apply-app-version.mjs && node scripts/run-tauri.mjs dev --features devtools",
    "tauri:build": "node scripts/apply-app-version.mjs && tauri build",
    "build:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-exe.ps1 -Installer",
    "build:portable": "tauri build --no-bundle --features portable && powershell -NoProfile -Command \"$ErrorActionPreference='Stop'; $out='artifacts/portable'; if (Test-Path $out) { Remove-Item -Recurse -Force $out }; New-Item -ItemType Directory -Force -Path (Join-Path $out 'data') | Out-Null; Copy-Item 'src-tauri/target/release/tiez-app.exe' -Destination (Join-Path $out 'tiez-app.exe') -Force; Set-Content -Path (Join-Path $out '说明.txt') -Value '本软件完全免费，严禁未经许可的第三方倒卖。`r`n`r`n便携版更新时，请从官网 https://tiez.name666.top 下载新版本，并替换原目录中的 tiez-app.exe；data 文件夹会保留你的数据。' -Encoding UTF8; Compress-Archive -Path (Join-Path $out '*') -DestinationPath (Join-Path $out 'tiez-portable.zip') -Force\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "framer-motion": "^12.25.0",
    "lucide-react": "^0.562.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-virtuoso": "^4.18.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react-refresh": "^0.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
